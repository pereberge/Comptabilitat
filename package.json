{
  "name": "contabilidad",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:split-companies": "node backend/scripts/company-databases.js",
    "db:migrate-companies": "node backend/scripts/migrate-companies.js",
    "integration:company": "node backend/scripts/integration-company.js",
    "test": "npm run test -w backend"
  }
}
