                 <xs:element name="Othr" type="GenericAccountIdentification1-BOI"/> -->
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
	    <xs:complexType name="AccountIdentification4Choice-BOI_IBAN">
        <xs:sequence>
            <xs:choice>
                <xs:element name="IBAN" type="IBAN2007Identifier"/>
