                <xs:element name="Othr" type="GenericFinancialIdentification1-BOI_SMNDA"/>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>
	
	<!-- BOI: added: SEPA version has fewer digits, uses EUR only -->
	<xs:simpleType name="ActiveOrHistoricCurrencyAndAmount_SimpleType_BOI">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0.01"/>
			<xs:fractionDigits value="2"/>
			<xs:totalDigits value="11"/>
		</xs:restriction>
	</xs:simpleType>

     <!--BOI: removed: Following tag removed as specified by the business-->
     <!--xs:maxInclusive value="999999999.99"-->
	
	<!-- BOI: added: SEPA version has fewer digits, uses EUR only -->
	<xs:complexType name="ActiveOrHistoricCurrencyAndAmount-BOI_EUR">
		<xs:simpleContent>
			<xs:extension base="ActiveOrHistoricCurrencyAndAmount_SimpleType_BOI">
				<xs:attribute name="Ccy" type="ActiveOrHistoricCurrencyCode-BOI_EUR" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
    <xs:simpleType name="ActiveOrHistoricCurrencyCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3,3}"/>
        </xs:restriction>
    </xs:simpleType>
	<xs:simpleType name="ActiveOrHistoricCurrencyCode-BOI_EUR">
		<xs:restriction base="xs:string">
			<xs:enumeration value="EUR"/>
		</xs:restriction>
	</xs:simpleType>

    <xs:complexType name="AmendmentInformationDetails6">
        <xs:sequence>
            <!-- 28.06 DS: Changed type of OrgnlMndtId to confirm with pacs003 restrictions -->
            <xs:element maxOccurs="1" minOccurs="0" name="OrgnlMndtId" type="BOIDDMndtID"/>
            <xs:element maxOccurs="1" minOccurs="0" name="OrgnlCdtrSchmeId" type="PartyIdentification32-BOI_Amd"/>
            <xs:element maxOccurs="1" minOccurs="0" name="OrgnlDbtrAcct" type="CashAccount16-BOI_Id"/>
            <xs:element maxOccurs="1" minOccurs="0" name="OrgnlDbtrAgt" type="BranchAndFinancialInstitutionIdentification4-BOI"/>
        </xs:sequence>
    </xs:complexType>
    <xs:simpleType name="AnyBICIdentifier">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BICIdentifier">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- BOI: added: replacement type for BranchAndFinancialInstitutionIdentification4 where only element FinInstnIdmay be used -->
    <xs:simpleType name="BOIBICIdentifier">
		<xs:restriction base="xs:string">
			<xs:enumeration value="BOFIIE2D"/>
			<!-- 10.07 DS: Added 11 digit BIC option-->
			<xs:enumeration value="BOFIIE2DXXX"/>
		</xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BatchBookingIndicator">
        <xs:restriction base="xs:boolean"/>
    </xs:simpleType>
	
	<!-- BOI: added: replacement type for BranchAndFinancialInstitutionIdentification4 where only element FinInstnIdmay be used -->
	<xs:complexType name="BranchAndFinancialInstitutionIdentification4-BOI_FinId">
		<xs:sequence>
			<xs:element name="FinInstnId" type="FinancialInstitutionIdentification7-BOI_Bic_CHOICE"/> <!-- IBAN only change-->

		</xs:sequence>
	</xs:complexType>

	<!-- BOI: added: replacement type for BranchAndFinancialInstitutionIdentification4 where only value 'BOFIIE2D' be used -->
	<xs:complexType name="BranchAndFinancialInstitutionIdentification4-BOI_BIC">
		<xs:sequence>
			<xs:element name="FinInstnId" type="FinancialInstitutionIdentification7-BOFI_CHOICE"/> <!-- IBAN only change-->

		</xs:sequence>
	</xs:complexType>


	<!-- BOI: added: replacement type for BranchAndFinancialInstitutionIdentification4 where only element SMNDA be used -->
	  <xs:complexType name="BranchAndFinancialInstitutionIdentification4-BOI">
		<xs:sequence>
		<!-- 23.06.2016 Changed type into "FinancialInstitutionIdentification7-BOI_Bic" as part of Pain008 EBA Rule book XSD changes -->
			<xs:element name="FinInstnId" type="FinancialInstitutionIdentification7-BOI_Bic"/>
		</xs:sequence>
	</xs:complexType>
	
	<!-- BOI: added: replacement type for CashAccount16 where only elements Id and Ccy may be used -->
	<xs:complexType name="CashAccount16-BOI_IdAndCurrency">
		<xs:sequence>
			<xs:element name="Id" type="AccountIdentification4Choice"/>
			<xs:element name="Ccy" type="ActiveOrHistoricCurrencyCode" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- BOI: added: replacement type for CashAccount16 where only element Id may be used -->
	<xs:complexType name="CashAccount16-BOI_Id">
		<xs:sequence>
			<xs:element name="Id" type="AccountIdentification4Choice-BOI_IBAN"/>
		</xs:sequence>
	</xs:complexType>

    <xs:complexType name="CategoryPurpose1Choice">
