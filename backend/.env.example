HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contabilidad
DB_USER=contabilidad_app
DB_PASSWORD=
COMPANY_ID=1

# Certificados solo para el portal de pruebas externas de AEAT.
# Cada empresa usa <company_id>.pfx dentro del directorio, fuera del repositorio.
VERIFACTU_CERT_DIR=
# VERIFACTU_PFX_PASSWORD_85=

# PDF de facturas: Edge instalado en Windows; Chrome por defecto en otros sistemas.
# INVOICE_PDF_BROWSER_CHANNEL=msedge
# INVOICE_PDF_BROWSER_PATH=C:/ruta/al/navegador.exe
# INVOICE_PDF_TEMP_DIR=F:/ruta/temporal-pdf

# Carpeta de copias automáticas. Por defecto: .local-backups/automatic en el proyecto.
# BACKUP_DIRECTORY=F:/copias-contabilitat
