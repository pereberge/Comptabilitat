HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contabilidad
DB_USER=contabilidad_app
DB_PASSWORD=
COMPANY_ID=1

# Enable only after db:split-companies has verified every company database.
COMPANY_DATABASES_ENABLED=false

# Service credentials for the versioned integration API. Store only token hashes.
INTEGRATION_CLIENTS_JSON=[]
# Example (replace the hash; no real credentials belong in this file):
# INTEGRATION_CLIENTS_JSON=[{"clientId":"gestio","sourceSystem":"gestio","tokenSha256":"<sha256-of-random-service-token>","scopes":["invoices:received:write"]}]
# In production set NODE_ENV=production and terminate TLS at a trusted proxy.
# INTEGRATION_TRUSTED_PROXIES=127.0.0.1,::1

# Certificados solo para el portal de pruebas externas de AEAT.
# Cada empresa usa <company_id>.pfx dentro del directorio, fuera del repositorio.
VERIFACTU_CERT_DIR=
# VERIFACTU_PFX_PASSWORD_85=

# PDF de facturas: Edge instalado en Windows; Chrome por defecto en otros sistemas.
# INVOICE_PDF_BROWSER_CHANNEL=msedge
# INVOICE_PDF_BROWSER_PATH=C:/ruta/al/navegador.exe
# INVOICE_PDF_TEMP_DIR=F:/ruta/temporal-pdf

# Carpeta de copias automáticas. Por defecto: .local-backups/automatic en el proyecto.
# BACKUP_DIRECTORY=F:/copias-contabilitat
