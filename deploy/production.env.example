NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contabilidad
DB_USER=contabilidad_app
DB_PASSWORD=REPLACE_ON_SERVER
COMPANY_ID=1
COMPANY_DATABASES_ENABLED=false
INTEGRATION_CLIENTS_JSON=[]
INTEGRATION_TRUSTED_PROXIES=127.0.0.1/32
BACKUP_DIRECTORY=/var/lib/comptabilitat/backups
INVOICE_PDF_TEMP_DIR=/var/lib/comptabilitat/pdf
# Install Chrome on the server, or set the path to a compatible Chromium.
# INVOICE_PDF_BROWSER_PATH=/usr/bin/chromium
# VERIFACTU_CERT_DIR=/etc/comptabilitat/certificates
