  },
  "components": {
    "securitySchemes": {
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque service token",
        "description": "Token de servei de 32 bytes aleatoris codificat base64url. Configurat pr?viament; no hi ha endpoint OAuth de token. No enviar la huella SHA-256."
      }
    },
    "schemas": {
      "Money": {
        "description": "Import signat en unitats monet?ries, m?xim 13 d?gits enters i 2 decimals. Preferir cadenes amb punt decimal.",
        "anyOf": [
          {
            "type": "string",
            "pattern": "^-?[0-9]{1,13}(\\.[0-9]{1,2})?$"
          },
          {
            "type": "number",
            "minimum": -9999999999999.99,
            "maximum": 9999999999999.99,
            "multipleOf": 0.01
          }
        ]
      },
      "Percentage": {
        "description": "Percentatge entre 0 i 100 amb un m?xim de 2 decimals; 21.00 significa 21%.",
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?:[0-9]{1,2}(?:\\.[0-9]{1,2})?|100(?:\\.0{1,2})?)$"
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "multipleOf": 0.01
          }
        ]
      },
      "Supplier": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "taxId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Es normalitzen espais, punts, guions i maj?scules; el resultat ha de ser alfanum?ric de 3 a 32 car?cters."
          },
          "address": {
            "type": "string",
            "maxLength": 250
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Correu amb format v?lid o cadena buida."
          }
        },
        "required": [
          "name",
          "taxId"
        ]
      },
      "TaxGroup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taxType": {
            "type": "string",
            "enum": [
              "vat",
              "exempt",
              "not_subject",
              "reverse_charge"
            ],
            "default": "vat"
          },
          "taxRate": {
            "$ref": "#/components/schemas/Percentage"
          },
          "taxableBase": {
            "$ref": "#/components/schemas/Money",
            "description": "Base signada; no pot ser zero."
          },
          "taxAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "exemptionReason": {
            "type": "string",
            "maxLength": 250,
            "description": "Obligatori i no buit en exempcions."
          }
        },
        "required": [
          "taxRate",
          "taxableBase",
          "taxAmount"
        ],
        "description": "Quota coherent amb base ? tipus, amb toler?ncia m?xima d?un c?ntim. Per a exempt, not_subject i reverse_charge, tipus i quota han de ser zero. Exempt requereix exemptionReason."
      },
      "Withholding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rate": {
            "$ref": "#/components/schemas/Percentage"
          },
          "base": {
            "$ref": "#/components/schemas/Money",
            "description": "Base no nul?la de la retenci?."
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "rate",
          "base",
          "amount"
        ]
      },
      "InvoiceLine": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "taxType": {
            "type": "string",
            "enum": [
              "vat",
              "exempt",
              "not_subject",
              "reverse_charge"
            ],
            "default": "vat"
          },
          "taxRate": {
            "$ref": "#/components/schemas/Percentage"
          },
          "taxableBase": {
            "$ref": "#/components/schemas/Money",
            "description": "Base signada; no pot ser zero."
          },
          "taxAmount": {
            "$ref": "#/components/schemas/Money"
          },
          "exemptionReason": {
            "type": "string",
            "maxLength": 250,
            "description": "Obligatori i no buit en exempcions."
          }
        },
        "required": [
          "description",
          "taxRate",
          "taxableBase",
          "taxAmount"
        ]
      },
      "Rectification": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "originalInvoiceNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "reason",
          "originalInvoiceNumber"
        ]
      },
      "ReceivedInvoice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceSystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Origen autoritzat de la credencial.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Identificador estable de la factura a Gesti?; es conserva en reintents.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "companyExternalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "?lies d?empresa autoritzat en el receptor.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "invoiceNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "N?mero del prove?dor. Tamb? ha de cabre en 60 car?cters despr?s de normalitzar-lo."
          },
          "invoiceDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "pattern": "^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$",
            "description": "Igual o posterior a invoiceDate."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Es normalitza a maj?scules; altres monedes diferents d?EUR requereixen revisi?."
          },
          "invoiceType": {
            "type": "string",
            "enum": [
              "standard",
              "credit_note",
              "rectifying"
            ],
            "default": "standard"
          },
          "rectification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rectification"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "taxBreakdown": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "$ref": "#/components/schemas/TaxGroup"
            }
          },
          "withholdings": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Withholding"
            },
            "default": []
          },
          "total": {
            "$ref": "#/components/schemas/Money",
            "description": "No pot ser zero. Exactament suma de bases + quotes ? retencions. Standard positiu; credit_note negatiu."
          },
          "documentExternalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Refer?ncia opaca del PDF a Gesti?. No es consulta com una URL."
          },
          "lines": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/InvoiceLine"
            },
            "default": [],
            "description": "Si hi ha l?nies, han de reconciliar exactament per tractament i tipus amb taxBreakdown."
          }
        },
        "required": [
          "sourceSystem",
          "externalId",
          "companyExternalId",
          "supplier",
          "invoiceNumber",
          "invoiceDate",
          "dueDate",
          "currency",
          "description",
          "taxBreakdown",
          "total",
          "documentExternalId"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "invoiceType": {
                  "enum": [
                    "credit_note",
                    "rectifying"
                  ]
                }
              },
              "required": [
                "invoiceType"
              ]
            },
            "then": {
              "required": [
                "rectification"
              ],
              "properties": {
                "rectification": {
                  "$ref": "#/components/schemas/Rectification"
                }
              }
            },
            "else": {
              "properties": {
                "rectification": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": [
          "pending",
          "posted",
          "issues",
          "cancelled",
          "rectified"
        ]
      },
      "ReceptionResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "companyId": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "possibleDuplicate": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Codis d?observaci?. Conservar tamb? codis desconeguts."
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "companyId",
          "sourceSystem",
          "externalId",
          "status",
          "possibleDuplicate",
          "issues",
          "replayed"
        ]
      },
      "ReceptionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReceptionResult"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      }
    }
  }
}
