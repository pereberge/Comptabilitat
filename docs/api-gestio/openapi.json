                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer realm=\"integrations\""
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
