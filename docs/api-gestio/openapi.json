{
  "openapi": "3.1.0",
  "info": {
    "title": "Comptabilitat ? recepci? de factures de Gesti?",
    "version": "1.0.0",
    "description": "Contracte del receptor implementat. Nom?s recepci? de dades estructurades, sense PDF ni assentaments autom?tics. La guia README.md completa les regles aritm?tiques i els reintents."
  },
  "servers": [
    {
      "url": "https://comptabilitat.example.com",
      "description": "Exemple: substituir per la URL real de producci?."
    },
    {
      "url": "http://127.0.0.1:3000",
      "description": "Desenvolupament local a la mateixa m?quina."
    }
  ],
  "security": [
    {
      "ServiceBearer": []
    }
  ],
  "paths": {
    "/api/v1/integrations/invoices/received": {
