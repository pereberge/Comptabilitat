              }
            }
          },
          "403": {
            "description": "INTEGRATION_SCOPE_REQUIRED, INTEGRATION_SOURCE_FORBIDDEN o INTEGRATION_COMPANY_FORBIDDEN.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "INTEGRATION_ENDPOINT_NOT_FOUND: ruta no disponible.",
            "headers": {
