                    },
                    "invoiceNumber": "DEMO-2026-002",
                    "invoiceDate": "2026-10-26",
                    "dueDate": "2026-11-26",
                    "currency": "EUR",
                    "invoiceType": "standard",
                    "description": "Factura amb IVA mixt, exempci? i retenci?",
                    "taxBreakdown": [
                      {
                        "taxType": "vat",
