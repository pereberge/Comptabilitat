                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "INTEGRATION_IDEMPOTENCY_CONFLICT: mateixa identitat externa amb altres dades.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "INTEGRATION_PAYLOAD_TOO_LARGE: m?xim 128 KiB.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "INTEGRATION_JSON_REQUIRED: cal application/json.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Camps, dates, impostos, l?nies o imports incoherents; veure error.code i error.field.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "426": {
            "description": "INTEGRATION_HTTPS_REQUIRED en producci?.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
