                        "taxAmount": "50.00"
                      },
                      {
                        "taxType": "exempt",
                        "taxRate": "0.00",
                        "taxableBase": "100.00",
                        "taxAmount": "0.00",
                        "exemptionReason": "Exempci? indicada pel prove?dor; revisar el sup?sit aplicable"
                      }
                    ],
                    "total": "1620.00",
                    "documentExternalId": "DOC-DEMO-002",
                    "withholdings": [
                      {
                        "rate": "15.00",
