                "creditNote": {
                  "value": {
                    "sourceSystem": "gestio",
                    "externalId": "FAC-DEMO-003",
                    "companyExternalId": "piensos-arb",
                    "supplier": {
                      "name": "Prove?dor Exemple SL",
                      "taxId": "B12345678"
                    },
                    "invoiceNumber": "DEMO-AB-2026-001",
                    "invoiceDate": "2026-10-26",
                    "dueDate": "2026-11-26",
                    "currency": "EUR",
                    "invoiceType": "credit_note",
                    "description": "Abonament per devoluci? de mercaderia",
                    "taxBreakdown": [
                      {
                        "taxType": "vat",
                        "taxRate": "21.00",
                        "taxableBase": "-1000.00",
                        "taxAmount": "-210.00"
                      }
                    ],
                    "total": "-1210.00",
                    "documentExternalId": "DOC-DEMO-003",
                    "rectification": {
                      "reason": "Devoluci? de mercaderia",
                      "originalInvoiceNumber": "DEMO-2026-001"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repetici? equivalent, mateix ID i replayed=true.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceptionResponse"
                }
              }
            }
          },
          "201": {
            "description": "Recepci? creada, replayed=false. Pot tenir incid?ncies; no significa comptabilitzada.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador de seguiment, tamb? retornat al cos JSON.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceptionResponse"
