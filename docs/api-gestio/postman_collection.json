{
  "info": {
    "name": "Comptabilitat API v1 ? Gesti?",
    "description": "Peticions de prova. Configura baseUrl, sourceSystem i companyExternalId. apiToken s?ha de proporcionar com a valor privat, sense exportar-lo. Les peticions creen recepcions; utilitza un entorn de proves. Executa la petici? 1 abans de la 2 i la 3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "apiToken",
      "value": ""
    },
    {
      "key": "sourceSystem",
      "value": "gestio"
    },
    {
      "key": "companyExternalId",
      "value": "piensos-arb"
    },
    {
      "key": "externalId",
      "value": "FAC-DEMO-001"
    },
    {
      "key": "invoiceNumber",
      "value": "DEMO-2026-001"
    }
  ],
  "item": [
    {
      "name": "1. Rebre factura normal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recepci? confirmada', function () { pm.expect([200,201]).to.include(pm.response.code); });",
              "if ([200,201].includes(pm.response.code)) { const r=pm.response.json(); pm.test('ID i seguiment presents',function(){pm.expect(r.data.id).to.be.a('number');pm.expect(r.requestId).to.eql(pm.response.headers.get('X-Request-Id'));}); }",
              "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('receptionId', String(pm.response.json().data.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceSystem\": \"{{sourceSystem}}\",\n  \"externalId\": \"{{externalId}}\",\n  \"companyExternalId\": \"{{companyExternalId}}\",\n  \"supplier\": {\n    \"name\": \"Prove?dor Exemple SL\",\n    \"taxId\": \"B12345678\"\n  },\n  \"invoiceNumber\": \"{{invoiceNumber}}\",\n  \"invoiceDate\": \"2026-10-26\",\n  \"dueDate\": \"2026-11-26\",\n  \"currency\": \"EUR\",\n  \"invoiceType\": \"standard\",\n  \"description\": \"Compra de mercaderies\",\n  \"taxBreakdown\": [\n    {\n      \"taxType\": \"vat\",\n      \"taxRate\": \"21.00\",\n      \"taxableBase\": \"1000.00\",\n      \"taxAmount\": \"210.00\"\n    }\n  ],\n  \"total\": \"1210.00\",\n  \"documentExternalId\": \"DOC-DEMO-001\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/integrations/invoices/received"
      }
    },
    {
      "name": "2. Repetir la mateixa factura",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if(pm.response.code===200){const r=pm.response.json();pm.test('Mateix ID, sense duplicar',function(){pm.expect(r.data.replayed).to.eql(true);pm.expect(String(r.data.id)).to.eql(pm.collectionVariables.get('receptionId'));});}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
